# BRD EWS HPT V3.2.1 section 28 (Environment Management). Copy to `.env` and adjust; every
# variable has a safe dev default baked into the code (see README.md section 1), so this file
# documents what's available rather than being strictly required.

# --- Host binding (section 5) ---
# Must stay 0.0.0.0 in production so Nginx (reverse-proxying /api on :80 - see
# ../deploy/nginx.ews-hpt.conf.example) can reach this process. Only narrow this if you have a
# specific reason to restrict the bind address.
HOST=0.0.0.0
PORT=4000

# --- Auth (change the secrets in any real deployment) ---
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Storage ---
EWS_DB_PATH=./ews.db
EWS_UPLOAD_ROOT=./uploads
