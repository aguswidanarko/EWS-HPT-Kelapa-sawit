# BRD EWS HPT V3.2.1 section 28 (Environment Management). Expo reads EXPO_PUBLIC_* vars at
# build/start time (see src/config.ts). Copy to `.env` for local development, or set directly in
# eas.json's per-profile `env` block for EAS builds (already done there for preview/production).

# LAN development AND LAN production both point at the same shared server in this org's workflow
# (there is no separate localhost dev target - see src/config.ts's header comment). Must go
# through the Nginx gateway on :80/`/api`, never straight to the backend's :4000 (section 3/4.1).
EXPO_PUBLIC_API_URL=http://10.110.1.9/api

# Internet-facing deployment (section 29 "target jangka panjang"):
# EXPO_PUBLIC_API_URL=https://api.domain.com/api
