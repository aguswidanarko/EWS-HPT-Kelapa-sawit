# BRD EWS HPT V3.2.1 section 28 (Environment Management). Expo reads EXPO_PUBLIC_* vars at
# build/start time (see src/config.ts). Copy to `.env` for local development, or set directly in
# eas.json's per-profile `env` block for EAS builds (already done there for preview/production).

# Production target (section 29 "target jangka panjang" - now live): the internet-facing
# dashboard/gateway host, fronted by Cloudflare. Must be https:// (Cloudflare redirects plain
# HTTP, and the app's networking stack doesn't reliably follow that redirect for POST requests -
# see src/config.ts). Must go through the Nginx gateway's `/api`, never straight to the backend's
# :4000 (section 3/4.1).
EXPO_PUBLIC_API_URL=https://ews-hpt-dashboard.first-resources.com/api

# LAN development (only if you're pointing at a local/LAN server instead of the host above - only
# reachable while on the office network, and plain http:// since the LAN origin has no TLS):
# EXPO_PUBLIC_API_URL=http://10.110.1.9/api
