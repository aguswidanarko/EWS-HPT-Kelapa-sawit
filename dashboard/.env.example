# BRD EWS HPT V3.2.1 section 28 (Environment Management). Vite reads VITE_* vars at build/dev-
# server start time (see src/api/client.js). Copy to `.env` for local development.

# Production target (section 29 "target jangka panjang" - now live): the internet-facing
# dashboard/gateway host. Must go through the Nginx gateway's `/api`, never straight to the
# backend's :4000 (section 8).
VITE_API_URL=http://ews-hpt-dashboard.first-resources.com/api

# LAN development (only if you're pointing at a local/LAN server instead of the host above):
# VITE_API_URL=http://10.110.1.9/api
