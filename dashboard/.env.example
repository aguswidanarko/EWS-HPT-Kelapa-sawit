# BRD EWS HPT V3.2.1 section 28 (Environment Management). Vite reads VITE_* vars at build/dev-
# server start time (see src/api/client.js). Copy to `.env` for local development.

# LAN development AND LAN production both point at the same shared server in this org's workflow
# (there is no separate localhost dev target - see src/api/client.js's header comment). Must go
# through the Nginx gateway on :80/`/api`, never straight to the backend's :4000 (section 8).
VITE_API_URL=http://10.110.1.9/api

# Internet-facing deployment (section 29 "target jangka panjang"):
# VITE_API_URL=https://api.domain.com/api
